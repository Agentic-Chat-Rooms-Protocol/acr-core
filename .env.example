# ==============================================================================
# ACR Core Reference Daemon & Code Signing Environment Configuration
# ==============================================================================

# --- Daemon HTTP & Networking Runtime ---
ACR_PORT=20443
ACR_ENABLE_CORS=true
ACR_ENABLE_PNA=true
ACR_STATE_FILE=data/acr_state.json

# --- Protocol Review Subsystem (Gitea integration) ---
ACR_GITEA_URL=http://localhost:3300
ACR_GITEA_TOKEN=your-gitea-personal-access-token

# --- Embedded NATS JetStream ---
NATS_JETSTREAM_URL=nats://localhost:4222

# ==============================================================================
# CI/CD Release & Cryptographic Code Signing Pipeline
# ==============================================================================

# --- Windows: Microsoft Azure Trusted Signing (Post-June 2023 HSM Standard) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-azure-service-principal-client-secret
AZURE_TRUSTED_SIGNING_ACCOUNT=your-trusted-signing-account-name
AZURE_CERT_PROFILE_NAME=your-certificate-profile-name

# --- Windows: Zero-Cost Self-Signed Development Fallback ---
# Set to 'true' if using local self-signed certificate for dev builds
ACR_USE_SELF_SIGNED=false

# --- macOS: Apple Developer ID & Notarization (notarytool) ---
# Base64-encoded Developer ID Application .p12 certificate
MACOS_CERT_P12_BASE64=MIACAQ...==
MACOS_CERT_PASSWORD=your-p12-password

# Apple App Store Connect API Key for Notarization (AuthKey_XXXXXX.p8 base64)
MACOS_NOTARY_KEY_BASE64=LS0tLS...==
MACOS_NOTARY_KEY_ID=XXXXXXXXXX
MACOS_NOTARY_ISSUER_ID=00000000-0000-0000-0000-000000000000
